# Optiwar Flask storefront — environment variables (names only, NO real values).
# Copy to a real .env (kept out of git) or set these in the systemd unit / drop-in.
# Values must be supplied per-environment; never commit real values.

# --- Core ---
SECRET_KEY=
TRUSTED_HOSTS=
CSRF_ENFORCE=true

# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=optiwar2
MYSQL_DATABASE=optiwar2
MYSQL_ADMIN_USER=
MYSQL_ADMIN_PASSWORD=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
OPTIWAR_WEBHOOK_SECRET=
TEST_PAY_ENABLED=false

# --- AI / LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
AI_DEEPSEEK_THINKING=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ADMIN_NOTIFY_EMAIL=
SUPPORT_TICKET_EMAIL_ENABLED=false
APP_TICKET_EMAIL_ENABLED=false

# --- SMS / WhatsApp (MSG91 / provider) ---
MSG91_AUTH_KEY=
MSG91_SMS_SENDER=
MSG91_WHATSAPP_NUMBER=
MSG91_RESET_OTP_FLOW_ID=
MSG91_RESET_OTP_WA_TEMPLATE=
MSG91_ORDER_CONFIRMED_SMS_FLOW=
MSG91_ORDER_SHIPPED_SMS_FLOW=
MSG91_TICKET_CREATED_SMS_FLOW=
MSG91_TICKET_RESOLVED_SMS_FLOW=
SMS_API_KEY=
SMS_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_TEMPLATE_ID=

# --- Shipping / courier ---
DELHIVERY_API_TOKEN=

# --- Google ---
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- KET support integration ---
KET_SUPPORT_URL=
KET_SUPPORT_KEY_OPTIWAR=
KET_SUPPORT_KEY_INOPTIWAR=
KET_EVENTS_ENABLED=false
KET_EVENT_CHANNELS=

# --- Ops / pricing dashboard ---
OPS_API_TOKEN=
PRICING_API_SECRET=
