    "semantics": {
      "min_single_eye_boxes": "minimum boxes required when the order is for ONE eye only — this is the owner-supplied source-table figure, authoritative as-is",
      "min_both_eyes_boxes_per_eye": "CONFIRMED RULE (owner, 2026-09-07): both-eyes total = min_single_eye_boxes, split equally per eye; if min_single_eye_boxes is odd (can't split evenly), round the TOTAL up to the next even number first, then split. Formula: min_both_eyes_boxes_per_eye = ceil(min_single_eye_boxes / 2). Example given: Soflens Dailies Torics, single=5 (odd) -> round total to 6 -> 3+3. This REPLACES the original source table's 'both combination' column, which did not follow this formula consistently (see source_table_both_value / formula_matches_source below).",
      "min_both_eyes_total_boxes": "derived = 2 * min_both_eyes_boxes_per_eye (equals min_single_eye_boxes when it was already even, or min_single_eye_boxes + 1 when it was odd)",
      "source_table_both_value": "the original 'both combination' number as pasted by the owner, kept for traceability only — do not use, superseded by the formula above",
      "formula_matches_source": "true if the formula's result equals the original source_table_both_value; false rows are flagged for a spot-check in case the source table intended something SKU-specific (stock/lab reasons) rather than the general even-split rule"
    },
    "cart_value_override": {
